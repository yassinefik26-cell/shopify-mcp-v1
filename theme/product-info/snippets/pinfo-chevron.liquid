{%- doc -%}
  The chevron shown at the end of each product-info accordion row.
  Rotates 180 degrees when its row is open (see .pinfo__row[open] .pinfo__chevron).

  @example
  {% render 'pinfo-chevron' %}
{%- enddoc -%}
<svg class="pinfo__chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
  <path d="m3 6 5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
