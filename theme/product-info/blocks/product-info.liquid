  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Composition and care text comes from each product's metafields: custom.composition and custom.care_instructions. Rows with no content are hidden automatically."
    },
    {
      "type": "header",
      "content": "Composition"
    },
    {
      "type": "text",
      "id": "composition_heading",
      "label": "Composition heading",
      "default": "Composition"
    },
    {
      "type": "text",
      "id": "care_heading",
      "label": "Row title",
      "default": "Composition & care"
    },
    {
      "type": "text",
      "id": "care_subheading",
      "label": "Care subheading",
      "default": "Care"
    },
    {
      "type": "header",
