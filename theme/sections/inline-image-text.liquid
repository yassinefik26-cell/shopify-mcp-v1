{%- comment -%}
  Inline image text
  -----------------
  A heading where small photo thumbnails sit inline between the words.

  The merchant composes the line in the theme editor by adding blocks in order:
    - "Text"  -> a run of words
    - "Image" -> a thumbnail rendered inline, on the text baseline

  Color comes from the theme's color scheme system (the `color-{{ scheme.id }}`
  class), so this inherits Analog's schemes rather than carrying its own palette.
  Everything else is a setting. No theme CSS, JS or snippet dependencies.

  Default proportions are measured from the reference design:
  thumbnails 1.2em wide x 1.68em tall at a 60px heading, line-height 1.7.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --iit-font-size: {{ s.font_size_mobile }}px;
    --iit-line-height: {{ s.line_height }};
    --iit-letter-spacing: {{ s.letter_spacing }}px;
    --iit-max-width: {{ s.max_width }}px;
    --iit-pad-top: {{ s.padding_top | times: 0.6 | round }}px;
    --iit-pad-bottom: {{ s.padding_bottom | times: 0.6 | round }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --iit-font-size: {{ s.font_size_desktop }}px;
      --iit-pad-top: {{ s.padding_top }}px;
      --iit-pad-bottom: {{ s.padding_bottom }}px;
    }
  }

  {%- comment -%}
    The scheme class lives on this wrapper, so the padding sits inside the
    scheme's background rather than outside it.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .inline-image-text-wrapper {
    padding-top: var(--iit-pad-top);
    padding-bottom: var(--iit-pad-bottom);
  }

  #shopify-section-{{ section.id }} .inline-image-text {
    max-width: var(--iit-max-width);
    margin-inline: auto;
    padding-inline: {{ s.horizontal_padding }}px;
    box-sizing: border-box;
  }

  {%- comment -%}
    Deliberately an inline formatting context, not flex: the thumbnails have to
    sit in the normal text flow so lines wrap around them the way words do.
    Color is inherited from the scheme class unless the merchant overrides it.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .inline-image-text__heading {
    display: block;
    margin: 0;
    font-size: var(--iit-font-size);
    line-height: var(--iit-line-height);
    letter-spacing: var(--iit-letter-spacing);
    text-align: {{ s.text_align }};
    {% if s.text_color_override != blank %}color: {{ s.text_color_override }};{% else %}color: inherit;{% endif %}
    {% if s.use_body_font %}font-family: inherit;{% endif %}
    {% if s.font_weight != 'inherit' %}font-weight: {{ s.font_weight }};{% endif %}
    {% if s.uppercase %}text-transform: uppercase;{% endif %}
    {% if s.balance_lines %}text-wrap: balance;{% endif %}
  }

  #shopify-section-{{ section.id }} .inline-image-text__words {
    display: inline;
    white-space: pre-wrap;
  }

  #shopify-section-{{ section.id }} .inline-image-text__media {
    display: inline-block;
    overflow: hidden;
    position: relative;
    vertical-align: middle;
    line-height: 0;
    box-sizing: content-box;
    /* Tints to the current scheme's text color, so it reads correctly on a
       light or a dark scheme without a dedicated setting. */
    background-color: rgba(128, 128, 128, 0.12);
    background-color: color-mix(in srgb, currentColor 12%, transparent);
  }

  #shopify-section-{{ section.id }} .inline-image-text__media img,
  #shopify-section-{{ section.id }} .inline-image-text__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} a.inline-image-text__media {
    transition: transform 220ms ease;
  }

  {%- if s.hover_effect -%}
    @media (hover: hover) {
      #shopify-section-{{ section.id }} a.inline-image-text__media:hover {
        transform: translateY(-0.08em) scale(1.06);
      }
    }
  {%- endif -%}

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} a.inline-image-text__media {
      transition: none;
    }
    #shopify-section-{{ section.id }} a.inline-image-text__media:hover {
      transform: none;
    }
  }

  {%- comment -%} Per-block geometry, shape, border and text color. {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'image' -%}
      {%- liquid
        assign radius = '50%'
        case block.settings.shape
          when 'rounded'
            assign radius = block.settings.corner_radius | append: 'px'
          when 'square'
            assign radius = '0'
        endcase
      -%}
      #shopify-section-{{ section.id }} [data-iit-block="{{ block.id }}"] {
        width: {{ block.settings.size }}em;
        height: {{ block.settings.size | times: block.settings.aspect_ratio }}em;
        border-radius: {{ radius }};
        margin-inline: {{ block.settings.gap }}em;
        top: {{ block.settings.offset_y }}em;
        {%- if block.settings.border_width > 0 %}
          border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
        {%- endif %}
      }
    {%- elsif block.settings.color != blank -%}
      #shopify-section-{{ section.id }} [data-iit-block="{{ block.id }}"] {
        color: {{ block.settings.color }};
      }
    {%- endif -%}
  {%- endfor -%}
{%- endstyle -%}

<div class="inline-image-text-wrapper color-{{ s.color_scheme }} gradient">
  <div class="inline-image-text">
    <{{ s.heading_tag }} class="inline-image-text__heading">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'text' -%}
            <span
              class="inline-image-text__words"
              data-iit-block="{{ block.id }}"
              {{ block.shopify_attributes }}
            >{{- block.settings.text -}}</span>

          {%- when 'image' -%}
            {%- liquid
              assign image = block.settings.image
              assign alt = block.settings.alt_text | default: image.alt
              assign px = block.settings.size | times: s.font_size_desktop | times: 3 | round
              if px < 120
                assign px = 120
              endif
            -%}

            {%- if block.settings.link != blank -%}
              <a
                class="inline-image-text__media"
                data-iit-block="{{ block.id }}"
                href="{{ block.settings.link }}"
                {% if alt == blank %}aria-hidden="true" tabindex="-1"{% endif %}
                {{ block.shopify_attributes }}
              >
            {%- else -%}
              <span
                class="inline-image-text__media"
                data-iit-block="{{ block.id }}"
                {% if alt == blank %}aria-hidden="true"{% endif %}
                {{ block.shopify_attributes }}
              >
            {%- endif -%}

            {%- if image != blank -%}
              {{
                image
                | image_url: width: px
                | image_tag:
                  loading: 'lazy',
                  widths: '120,180,240,360,480,720',
                  sizes: '10vw',
                  alt: alt
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'inline-image-text__placeholder' }}
            {%- endif -%}

            {%- if block.settings.link != blank -%}</a>{%- else -%}</span>{%- endif -%}

        {%- endcase -%}
      {%- endfor -%}
    </{{ s.heading_tag }}>
  </div>
</div>

{% schema %}
{
  "name": "Inline image text",
  "tag": "section",
  "class": "section-inline-image-text",
  "max_blocks": 30,
  "settings": [
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "text_color_override",
      "label": "Text color override",
      "info": "Leave empty to use the color scheme's text color."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "info": "Use H1 only once per page. Choose Paragraph if this is decorative.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "balance_lines",
      "label": "Balance line lengths",
      "info": "Evens out the number of words per line. Turn off if you want lines to fill fully before wrapping.",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 400,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Type"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Font size (desktop)",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size (mobile)",
      "min": 16,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line height",
      "info": "Tall thumbnails need room. Around 1.7 matches the reference layout.",
      "min": 0.9,
      "max": 2.4,
      "step": 0.05,
      "default": 1.7
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": -3,
      "max": 5,
      "step": 0.1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "inherit"
    },
    {
      "type": "checkbox",
      "id": "use_body_font",
      "label": "Use body font instead of heading font",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase",
      "default": false
    },
    {
      "type": "header",
      "content": "Thumbnails"
    },
    {
      "type": "checkbox",
      "id": "hover_effect",
      "label": "Lift linked thumbnails on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "info": "A run of words. Leading and trailing spaces are preserved, so you can fine-tune spacing around thumbnails.",
          "default": "Saltwater swimwear"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text color",
          "info": "Leave empty to match the rest of the line. Use it to fade the closing words, as in the reference."
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "shape",
          "label": "Shape",
          "info": "Ellipse becomes a perfect circle when Height ratio is 1.",
          "options": [
            { "value": "ellipse", "label": "Ellipse / circle" },
            { "value": "rounded", "label": "Rounded rectangle" },
            { "value": "square", "label": "Square" }
          ],
          "default": "ellipse"
        },
        {
          "type": "range",
          "id": "corner_radius",
          "label": "Corner radius",
          "info": "Applies to the Rounded rectangle shape only.",
          "min": 0,
          "max": 40,
          "step": 2,
          "unit": "px",
          "default": 12
        },
        {
          "type": "range",
          "id": "size",
          "label": "Width",
          "info": "Relative to the text, so thumbnails scale with the font size.",
          "min": 0.5,
          "max": 2.5,
          "step": 0.05,
          "unit": "em",
          "default": 1.2
        },
        {
          "type": "range",
          "id": "aspect_ratio",
          "label": "Height ratio",
          "info": "Height as a multiple of width. 1.4 is the upright oval in the reference; 0.7 gives a wide landscape crop.",
          "min": 0.5,
          "max": 2,
          "step": 0.05,
          "default": 1.4
        },
        {
          "type": "range",
          "id": "gap",
          "label": "Space on each side",
          "info": "0.24em matches the reference, roughly one word-space either side.",
          "min": 0,
          "max": 0.8,
          "step": 0.02,
          "unit": "em",
          "default": 0.24
        },
        {
          "type": "range",
          "id": "offset_y",
          "label": "Vertical nudge",
          "info": "Fine-tune how the thumbnail sits against the text.",
          "min": -0.4,
          "max": 0.4,
          "step": 0.02,
          "default": 0
        },
        {
          "type": "range",
          "id": "border_width",
          "label": "Border width",
          "min": 0,
          "max": 6,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Border color",
          "default": "#ffffff"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text",
          "info": "Leave empty if the thumbnail is decorative. It is then hidden from screen readers so the sentence still reads cleanly. A linked thumbnail with no alt text is also skipped by keyboard navigation, so give any thumbnail that links somewhere useful a description."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Inline image text",
      "blocks": [
        { "type": "text", "settings": { "text": "Saltwater swimwear" } },
        { "type": "image" },
        { "type": "text", "settings": { "text": "with a secure fit" } },
        { "type": "image" },
        { "type": "text", "settings": { "text": "soft recycled fabrics" } },
        { "type": "image" },
        { "type": "text", "settings": { "text": "and freedom of movement" } },
        {
          "type": "image",
          "settings": { "shape": "rounded", "size": 1.95, "aspect_ratio": 0.7 }
        }
      ]
    }
  ]
}
{% endschema %}
