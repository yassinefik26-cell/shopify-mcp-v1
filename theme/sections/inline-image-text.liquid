{%- comment -%}
  Inline image text
  -----------------
  A heading where small photo thumbnails sit inline between the words.

  The merchant composes the line in the theme editor by adding blocks in order:
    - "Text"  -> a run of words
    - "Image" -> a thumbnail rendered inline, on the text baseline

  Every visual property is a setting, so no code edits are needed to retheme it.
  Self-contained: no theme CSS, JS or snippet dependencies.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --iit-font-size: {{ s.font_size_mobile }}px;
    --iit-line-height: {{ s.line_height }};
    --iit-letter-spacing: {{ s.letter_spacing }}px;
    --iit-text-color: {{ s.text_color }};
    --iit-max-width: {{ s.max_width }}px;
    --iit-pad-top: {{ s.padding_top | times: 0.6 | round }}px;
    --iit-pad-bottom: {{ s.padding_bottom | times: 0.6 | round }}px;

    background-color: {{ s.background_color }};
    padding-top: var(--iit-pad-top);
    padding-bottom: var(--iit-pad-bottom);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --iit-font-size: {{ s.font_size_desktop }}px;
      --iit-pad-top: {{ s.padding_top }}px;
      --iit-pad-bottom: {{ s.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .inline-image-text {
    max-width: var(--iit-max-width);
    margin-inline: auto;
    padding-inline: {{ s.horizontal_padding }}px;
    box-sizing: border-box;
  }

  /* Deliberately an inline formatting context, not flex: the thumbnails have
     to sit in the normal text flow so lines wrap around them like words do. */
  #shopify-section-{{ section.id }} .inline-image-text__heading {
    display: block;
    margin: 0;
    color: var(--iit-text-color);
    font-size: var(--iit-font-size);
    line-height: var(--iit-line-height);
    letter-spacing: var(--iit-letter-spacing);
    text-align: {{ s.text_align }};
    {% if s.use_body_font %}font-family: inherit;{% endif %}
    {% if s.font_weight != 'inherit' %}font-weight: {{ s.font_weight }};{% endif %}
    {% if s.uppercase %}text-transform: uppercase;{% endif %}
    text-wrap: balance;
  }

  /* Text runs keep their own inner spacing; the gap either side of a
     thumbnail is owned by the thumbnail so adjacent words never collide. */
  #shopify-section-{{ section.id }} .inline-image-text__words {
    display: inline;
    white-space: pre-wrap;
  }

  #shopify-section-{{ section.id }} .inline-image-text__media {
    display: inline-block;
    overflow: hidden;
    position: relative;
    vertical-align: middle;
    line-height: 0;
    box-sizing: content-box;
    background-color: {{ s.placeholder_color }};
  }

  #shopify-section-{{ section.id }} .inline-image-text__media img,
  #shopify-section-{{ section.id }} .inline-image-text__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} a.inline-image-text__media {
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  {%- if s.hover_effect -%}
    @media (hover: hover) {
      #shopify-section-{{ section.id }} a.inline-image-text__media:hover {
        transform: translateY(-0.08em) scale(1.06);
      }
    }
  {%- endif -%}

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} a.inline-image-text__media {
      transition: none;
    }
    #shopify-section-{{ section.id }} a.inline-image-text__media:hover {
      transform: none;
    }
  }

  {%- comment -%} Per-block sizing, shape and border. {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'image' -%}
      {%- liquid
        assign radius = '50%'
        case block.settings.shape
          when 'rounded'
            assign radius = block.settings.corner_radius | append: 'px'
          when 'square'
            assign radius = '0'
        endcase
      -%}
      #shopify-section-{{ section.id }} [data-iit-block="{{ block.id }}"] {
        width: {{ block.settings.size }}em;
        height: {{ block.settings.size | times: block.settings.aspect_ratio }}em;
        border-radius: {{ radius }};
        margin-inline: {{ block.settings.gap }}em;
        top: {{ block.settings.offset_y }}em;
        {%- if block.settings.border_width > 0 %}
          border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
        {%- endif %}
      }
    {%- endif -%}
  {%- endfor -%}
{%- endstyle -%}

<div class="inline-image-text">
  <{{ s.heading_tag }} class="inline-image-text__heading">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'text' -%}
          <span class="inline-image-text__words" {{ block.shopify_attributes }}>
            {{- block.settings.text -}}
          </span>

        {%- when 'image' -%}
          {%- liquid
            assign image = block.settings.image
            assign alt = block.settings.alt_text | default: image.alt
            assign px = block.settings.size | times: s.font_size_desktop | times: 3 | round
            if px < 120
              assign px = 120
            endif
          -%}

          {%- if block.settings.link != blank -%}
            <a
              class="inline-image-text__media"
              data-iit-block="{{ block.id }}"
              href="{{ block.settings.link }}"
              {% if alt == blank %}aria-hidden="true" tabindex="-1"{% endif %}
              {{ block.shopify_attributes }}
            >
          {%- else -%}
            <span
              class="inline-image-text__media"
              data-iit-block="{{ block.id }}"
              {% if alt == blank %}aria-hidden="true"{% endif %}
              {{ block.shopify_attributes }}
            >
          {%- endif -%}

          {%- if image != blank -%}
            {{
              image
              | image_url: width: px
              | image_tag:
                loading: 'lazy',
                widths: '120,180,240,360,480,720',
                sizes: '10vw',
                alt: alt
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'inline-image-text__placeholder' }}
          {%- endif -%}

          {%- if block.settings.link != blank -%}</a>{%- else -%}</span>{%- endif -%}

      {%- endcase -%}
    {%- endfor -%}
  </{{ s.heading_tag }}>
</div>

{% schema %}
{
  "name": "Inline image text",
  "tag": "section",
  "class": "section-inline-image-text",
  "max_blocks": 30,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "info": "Use H1 only once per page. Choose Paragraph if this is decorative.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 400,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1000
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Type"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Font size (desktop)",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size (mobile)",
      "min": 16,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line height",
      "min": 0.9,
      "max": 2,
      "step": 0.05,
      "default": 1.3
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": -3,
      "max": 5,
      "step": 0.1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "inherit"
    },
    {
      "type": "checkbox",
      "id": "use_body_font",
      "label": "Use body font instead of heading font",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Thumbnail placeholder",
      "info": "Shows behind a thumbnail while its image loads.",
      "default": "#ebe8e3"
    },
    {
      "type": "header",
      "content": "Thumbnails"
    },
    {
      "type": "checkbox",
      "id": "hover_effect",
      "label": "Lift linked thumbnails on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "info": "A run of words. Leading and trailing spaces are preserved, so you control the spacing around thumbnails.",
          "default": "Made by people who"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "shape",
          "label": "Shape",
          "options": [
            { "value": "circle", "label": "Circle" },
            { "value": "rounded", "label": "Rounded" },
            { "value": "square", "label": "Square" }
          ],
          "default": "circle"
        },
        {
          "type": "range",
          "id": "corner_radius",
          "label": "Corner radius",
          "info": "Applies to the Rounded shape only.",
          "min": 0,
          "max": 40,
          "step": 2,
          "unit": "px",
          "default": 10
        },
        {
          "type": "range",
          "id": "size",
          "label": "Size",
          "info": "Relative to the text, so thumbnails scale with the font size.",
          "min": 0.5,
          "max": 2.5,
          "step": 0.05,
          "unit": "em",
          "default": 1.1
        },
        {
          "type": "range",
          "id": "aspect_ratio",
          "label": "Height ratio",
          "info": "1 is a perfect circle or square. Above 1 makes a tall pill, below 1 a wide one.",
          "min": 0.5,
          "max": 2,
          "step": 0.05,
          "default": 1
        },
        {
          "type": "range",
          "id": "gap",
          "label": "Space on each side",
          "min": 0,
          "max": 0.8,
          "step": 0.02,
          "unit": "em",
          "default": 0.18
        },
        {
          "type": "range",
          "id": "offset_y",
          "label": "Vertical nudge",
          "info": "Fine-tune how the thumbnail sits against the text.",
          "min": -0.4,
          "max": 0.4,
          "step": 0.02,
          "unit": "em",
          "default": 0
        },
        {
          "type": "range",
          "id": "border_width",
          "label": "Border width",
          "min": 0,
          "max": 6,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Border color",
          "default": "#ffffff"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text",
          "info": "Leave empty if the thumbnail is decorative. It is then hidden from screen readers so the sentence still reads cleanly."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Inline image text",
      "blocks": [
        { "type": "text", "settings": { "text": "Everyday essentials" } },
        { "type": "image" },
        { "type": "text", "settings": { "text": "built to last, shipped" } },
        { "type": "image" },
        { "type": "text", "settings": { "text": "worldwide." } }
      ]
    }
  ]
}
{% endschema %}
